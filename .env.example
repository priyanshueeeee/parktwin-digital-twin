# ParkTwin Local Configuration (copy to .env for local runs)
PARKTWIN_ENV=development
PARKTWIN_SCHEMA_VERSION=v1
PARKTWIN_SERVICE_VERSION=0.1.0-segment-b

# Database (PostgreSQL in Docker Compose; SQLite supported for local tests)
DATABASE_URL=postgresql+psycopg2://parktwin:parktwin@localhost:5432/parktwin

# Authentication & Authorization
# Format: comma-separated token:actor_id:role entries
PARKTWIN_AUTH_ENABLED=true
PARKTWIN_API_KEYS=dev-clinician-key:clinician-demo-01:clinician,dev-admin-key:admin-demo-01:admin,dev-readonly-key:viewer-demo-01:readonly

# Request protections
PARKTWIN_MAX_PAYLOAD_BYTES=65536
PARKTWIN_RATE_LIMIT_REQUESTS=120
PARKTWIN_RATE_LIMIT_WINDOW_SECONDS=60

# CORS (comma-separated frontend origins)
PARKTWIN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Twin computation adapter (switch to "real" after merging Segment A)
PARKTWIN_ENGINE_ADAPTER=mock
PARKTWIN_REAL_ADAPTER_PATH=app.services.adapter:build_real_engine_adapter
# Promoted Segment A artifacts (required when PARKTWIN_ENGINE_ADAPTER=real).
PARKTWIN_TOTAL_ARTIFACT_PATH=ml/artifacts/total/random_forest-total_UPDRS.joblib
PARKTWIN_MOTOR_ARTIFACT_PATH=ml/artifacts/motor/random_forest-motor_UPDRS.joblib
PARKTWIN_STALE_DAYS_THRESHOLD=30
